<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="50dp">

        <!-- Ucapan Selamat Datang dengan Background Rounded -->
        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Selamat datang di BookSport!"
            android:textSize="24sp"
            android:textStyle="bold"
            android:background="@drawable/rounded_background"
            android:textColor="#FFFFFF"
            android:padding="12dp"
            android:gravity="center" />

        <!-- Teks Pilih Aktivitas -->
        <TextView
            android:id="@+id/tvPilihAktivitas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Pilih Aktivitas"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Gambar Pilihan Olahraga (Futsal, Basketball, Badminton) -->
        <ImageView
            android:id="@+id/ivFutsal"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/circular_shape"
            android:clickable="true"
            android:contentDescription="Futsal"
            android:focusable="true"
            android:scaleType="centerCrop"
            android:src="@drawable/futsal_image" />

        <TextView
            android:id="@+id/tvPilihAktivitas2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:clickable="true"
            android:focusable="true"
            android:text="Mini Soccer"
            android:textAlignment="center"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivBasketball"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/circular_shape"
            android:clickable="true"
            android:contentDescription="Basketball"
            android:focusable="true"
            android:scaleType="centerCrop"
            android:src="@drawable/basketball_image" />

        <TextView
            android:id="@+id/tvPilihAktivitas3"
            android:layout_width="112dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:clickable="true"
            android:focusable="true"
            android:text="Basketball"
            android:textAlignment="center"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivBadminton"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="2dp"
            android:background="@drawable/circular_shape"
            android:clickable="true"
            android:contentDescription="Badminton"
            android:focusable="true"
            android:scaleType="centerCrop"
            android:src="@drawable/badminton_image" />

        <TextView
            android:id="@+id/tvPilihAktivitas4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:clickable="true"
            android:focusable="true"
            android:text="Badminton"
            android:textAlignment="center"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
